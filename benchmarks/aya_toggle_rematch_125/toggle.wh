program toggle
contract integer_overflow = wrap
input seed: u64
input steps: u64
iterate toggle limit steps {
    state x: u64 = seed
    state i: u64 = 0
    while i < steps
    update x = 1 - x
    update i = i + 1
    result x
}
publish toggle
test (1, 0) => { toggle = 1 }
test (1, 1) => { toggle = 0 }
