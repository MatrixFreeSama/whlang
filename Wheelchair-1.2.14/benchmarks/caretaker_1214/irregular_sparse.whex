program irregular_sparse_nonlinear
tolerance 1e-10
input n: u64 range 4..100000000
field x[i in n]: f64 = -0.375 + cast(f64, (i * 31 + 5) % 1024) / 1024.0
field y[i in n]: f64 = 1.25 * x[i] - 0.125 * x[(i * 97 + 17) % n] + 0.0625 * x[(i * 193 + 31) % n] - 0.03125 * x[(i * 389 + 47) % n] + 0.015625 * x[(i * 769 + 71) % n] - 0.0078125 * x[(i * 1543 + 101) % n] + 0.00390625 * x[(i * 3079 + 131) % n] - 0.001953125 * x[(i * 6151 + 167) % n] + 0.0009765625 * x[(i * 12289 + 211) % n] - 0.00048828125 * x[(i * 24593 + 257) % n] + 0.000244140625 * x[(i * 49157 + 313) % n] + 0.0078125 * x[i] * x[i] * x[i] + 0.00390625 * x[(i * 97 + 17) % n] * x[(i * 49157 + 313) % n]
sum checksum[i in n]: f64 = y[i]
output checksum
test (4) => { checksum = 0.0 }
