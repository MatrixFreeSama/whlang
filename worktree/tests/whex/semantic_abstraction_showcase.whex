program whex_topology_showcase
strict
input n: u64 range 4..16
axis i in n
record constants {
    shift = 2.0
}
pure generic fn value(x: u64) -> f64 = cast(f64, x) - constants.shift
region compute effect pure parallel {
    field x[i in n]: f64 = value(i)
    sum total[i in n]: f64 = x[i]
}
output total
test (4) => { total = -2.0 }
