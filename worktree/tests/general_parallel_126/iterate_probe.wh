program general_parallel_iterate_probe
contract integer_overflow = wrap
input left_seed: u64
input right_seed: u64
input steps: u64
iterate left limit steps {
    state x: u64 = left_seed
    state i: u64 = 0
    while i < steps
    update x = x * 3 + 1
    update i = i + 1
    result x
}
iterate right limit steps {
    state x: u64 = right_seed
    state i: u64 = 0
    while i < steps
    update x = x * 5 + 2
    update i = i + 1
    result x
}
let total = left + right
output total = total
output left = left
output right = right
test (2, 5, 3) => { total = 754; left = 67; right = 687 }
