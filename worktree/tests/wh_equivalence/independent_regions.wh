program semantic_independent_regions
strict
input n: u64 range 4..1024
region left effect pure parallel {
    for i in 0..n {
        let a[i]: f64 = cast(f64, i) + 1.0
    }
}
region right effect pure parallel {
    for i in 0..n {
        let b[i]: f64 = cast(f64, i) * 2.0
    }
}
region closure effect pure parallel {
    for i in 0..n {
        total += a[i] + b[i]
    }
}
output total
test (4) => { total = 24.0 }
