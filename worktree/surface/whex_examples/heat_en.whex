program whex_heat_equivalence
tolerance 1e-10
input n: u64 range 4..100000000

field u[i in n]: f64 = 0.25 + cast(f64, (i * 17 + 3) % 1024) / 1024.0

each i in n {
    next: f64 = u[i] + 0.125 * (u[periodic(i + n - 1, n)] - 2.0 * u[i] + u[periodic(i + 1, n)])
}

sum checksum[i in n]: f64 = next[i]
output checksum

test (4) => { checksum = 1.111328125 }
