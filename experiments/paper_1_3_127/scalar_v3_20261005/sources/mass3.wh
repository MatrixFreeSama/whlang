program mass3_chain
input steps: u64
iterate sim limit steps {
 state x1: f64 = 0.10
 state v1: f64 = 0.00
 state x2: f64 = -0.05
 state v2: f64 = 0.02
 state x3: f64 = 0.08
 state v3: f64 = -0.01
 state i: u64 = 0
 while i < steps
 update x1 = x1 + (v1 * 0.0001)
 update v1 = v1 + (((((-0.8 * x1) + (0.3 * (x2 - x1))) - (0.05 * v1)) + (0.02 * (v2 - v1))) * 0.0001)
 update x2 = x2 + (v2 * 0.0001)
 update v2 = v2 + (((((0.25 * (x1 - x2)) + (0.35 * (x3 - x2))) + (0.018 * (v1 - v2))) + (0.022 * (v3 - v2))) * 0.0001)
 update x3 = x3 + (v3 * 0.0001)
 update v3 = v3 + (((((0.4 * (x2 - x3)) - (0.7 * x3)) + (0.025 * (v2 - v3))) - (0.06 * v3)) * 0.0001)
 update i = i + 1
 result x3
}
publish sim
test (0) => { sim = 0.08 }
