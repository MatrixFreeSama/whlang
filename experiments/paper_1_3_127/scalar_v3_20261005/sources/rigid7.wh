program rigid7_attitude
input steps: u64
iterate sim limit steps {
    state q0: f64 = 1.0
    state q1: f64 = 0.01
    state q2: f64 = -0.02
    state q3: f64 = 0.03
    state wx: f64 = 1.2
    state wy: f64 = -0.7
    state wz: f64 = 0.9
    state i: u64 = 0
    while i < steps
    update q0 = q0 + (((-0.5 * (((q1 * wx) + (q2 * wy)) + (q3 * wz))) + ((0.15 * (1.0 - ((((q0 * q0) + (q1 * q1)) + (q2 * q2)) + (q3 * q3)))) * q0)) * 0.00001)
    update q1 = q1 + (((0.5 * (((q0 * wx) + (q2 * wz)) - (q3 * wy))) + ((0.15 * (1.0 - ((((q0 * q0) + (q1 * q1)) + (q2 * q2)) + (q3 * q3)))) * q1)) * 0.00001)
    update q2 = q2 + (((0.5 * (((q0 * wy) + (q3 * wx)) - (q1 * wz))) + ((0.15 * (1.0 - ((((q0 * q0) + (q1 * q1)) + (q2 * q2)) + (q3 * q3)))) * q2)) * 0.00001)
    update q3 = q3 + (((0.5 * (((q0 * wz) + (q1 * wy)) - (q2 * wx))) + ((0.15 * (1.0 - ((((q0 * q0) + (q1 * q1)) + (q2 * q2)) + (q3 * q3)))) * q3)) * 0.00001)
    update wx = wx + ((((0.6 * wy) * wz) - (0.02 * wx)) * 0.00001)
    update wy = wy + ((((-0.4 * wz) * wx) - (0.025 * wy)) * 0.00001)
    update wz = wz + ((((0.2 * wx) * wy) - (0.03 * wz)) * 0.00001)
    update i = i + 1
    result q3
}
publish sim
test (0) => { sim = 0.03 }
